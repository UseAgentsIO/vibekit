{
  "name": "@useagentsio/vibekit",
  "version": "1.2.1",
  "description": "VibeKit CLI for initializing Projects and installing Modules",
  "type": "module",
  "license": "UNLICENSED",
  "author": "UseAgentsIO",
  "homepage": "https://github.com/UseAgentsIO/vibekit#readme",
  "bugs": {
    "url": "https://github.com/UseAgentsIO/vibekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UseAgentsIO/vibekit.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "vibekit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "registry",
    "schemas"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/prepare-publish.mjs cli && node ../../scripts/clean-product-dist.mjs && tsc -b && node ../../scripts/validate-product-dist.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.7.2",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "playwright": "^1.50.0"
  }
}
