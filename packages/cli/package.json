{
  "name": "@useagentsio/cli",
  "version": "0.1.1",
  "description": "VibeKit CLI for initializing Projects and installing Modules",
  "type": "module",
  "license": "UNLICENSED",
  "author": "UseAgentsIO",
  "homepage": "https://github.com/UseAgentsIO/vibekit#readme",
  "bugs": {
    "url": "https://github.com/UseAgentsIO/vibekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UseAgentsIO/vibekit.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "vibekit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/prepare-publish.mjs cli && tsc -b"
  },
  "dependencies": {
    "@useagentsio/core": "workspace:*"
  }
}
