{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "title": "VibeKit Project",
  "description": "Canonical Project contract at .vibekit/project.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "id": { "$ref": "module.schema.json#/definitions/projectId" },
    "name": { "type": "string", "minLength": 1 },
    "root": { "$ref": "module.schema.json#/definitions/fileTarget" },
    "workspace": { "$ref": "module.schema.json#/definitions/fileTarget" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "defaultAgent": { "$ref": "module.schema.json#/definitions/bindingName" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retainedConversations": { "type": "integer", "minimum": 1 },
        "maxParallelConversations": { "type": "integer", "minimum": 1 },
        "sameConversationPolicy": { "type": "string", "enum": ["serialize"] },
        "shutdownGraceMs": { "type": "integer", "minimum": 1 }
      }
    },
    "interfaceBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definition", "enabled", "defaultAgent"],
        "properties": {
          "definition": { "$ref": "module.schema.json#/definitions/moduleId" },
          "enabled": { "type": "boolean" },
          "defaultAgent": { "$ref": "module.schema.json#/definitions/bindingName" },
          "config": { "$ref": "module.schema.json#/definitions/fileTarget" }
        }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatibility": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "$ref": "module.schema.json#/definitions/moduleId" },
        "path": { "$ref": "module.schema.json#/definitions/fileTarget" },
        "tracking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conversations": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "decisions": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "tasks": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "results": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "approvals": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "verifications": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "events": { "$ref": "module.schema.json#/definitions/trackingMode" },
            "runtime": { "$ref": "module.schema.json#/definitions/trackingMode" }
          }
        }
      }
    },
    "agentBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definition"],
        "properties": {
          "definition": { "$ref": "module.schema.json#/definitions/agentId" }
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "module.schema.json#/definitions/bindingName" }
      }
    },
    "capabilityBindings": {
      "type": "object",
      "additionalProperties": { "$ref": "module.schema.json#/definitions/moduleId" }
    },
    "policies": {
      "type": "array",
      "items": { "$ref": "module.schema.json#/definitions/moduleId" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallelRuns": { "type": "integer", "minimum": 1 },
        "defaultIsolation": { "$ref": "module.schema.json#/definitions/isolationMode" },
        "mutationIsolation": { "$ref": "module.schema.json#/definitions/isolationMode" },
        "defaultTimeoutMs": { "type": "integer", "minimum": 1 },
        "maxDelegationDepth": { "type": "integer", "minimum": 0 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "module.schema.json#/definitions/authorizationMode" },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "module.schema.json#/definitions/authorizationMode"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "module.schema.json#/definitions/moduleIdList" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "derived": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "untrusted": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
