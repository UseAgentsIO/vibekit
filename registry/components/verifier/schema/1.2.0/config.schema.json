{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verifier:schema configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*\\.\\.)[^\\u0000\\\\]+$",
      "description": "Relative Project path to a JSON Schema file."
    },
    "schema": {
      "type": "object",
      "description": "Inline JSON Schema object. Used when schemaPath is omitted."
    }
  }
}
