{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "policy:interface-pairing configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pairingTtlSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "default": 600,
      "description": "Seconds a pairing code remains redeemable before it expires."
    },
    "storePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*\\.\\.)[^\\u0000\\\\]+$",
      "default": ".vibekit/runtime/interface-pairing.json",
      "description": "Relative Project path for pairing codes and allowlisted senders."
    }
  }
}
